# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- Targets (QA / local ONLY — global-setup refuses production-looking hosts) ----
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080/api

# Extra hosts that are QA even though their name doesn't contain qa/dev/staging/test/uat.
# Comma-separated hostnames, e.g. hims-review.internal.example.com
QA_ALLOWED_HOSTS=

# ---- Auth ----
# api    = POST ${API_BASE_URL}${LOGIN_PATH} with the creds below (default)
# manual = never call the API; use only tokens captured with `npm run auth:manual -- <role>`
AUTH_MODE=api
LOGIN_PATH=/auth/login
# JSON body template. {{phone}} {{password}} {{otp}} {{role}} are substituted;
# keys whose value ends up empty are dropped. Add a QA reCAPTCHA bypass field here if the backend has one.
LOGIN_BODY_TEMPLATE={"phone":"{{phone}}","password":"{{password}}","otp":"{{otp}}"}
# Header scheme used when specs call the API directly with a role token.
API_AUTH_SCHEME=Bearer
# Path of the UI login page (used by the manual capture script).
UI_LOGIN_PATH=/

# One test account per role. A role with no creds and no cached token is skipped, not failed.
TEST_SUPERADMIN_PHONE=
TEST_SUPERADMIN_PASSWORD=
TEST_SUPERADMIN_OTP=

TEST_ADMIN_PHONE=
TEST_ADMIN_PASSWORD=
TEST_ADMIN_OTP=

TEST_RECEPTION_PHONE=
TEST_RECEPTION_PASSWORD=
TEST_RECEPTION_OTP=

TEST_DOCTOR_PHONE=
TEST_DOCTOR_PASSWORD=
TEST_DOCTOR_OTP=

TEST_DIAGNOSTIC_PHONE=
TEST_DIAGNOSTIC_PASSWORD=
TEST_DIAGNOSTIC_OTP=

TEST_PHARMACY_PHONE=
TEST_PHARMACY_PASSWORD=
TEST_PHARMACY_OTP=

# ---- Seed data for data-dependent specs (see README "Seed data") ----
# PH-FUN-001: in-app path of a pharmacy cart that already holds >=1 item
PH_CART_PATH=
# PH-BIZ-003: a throwaway patient id the pharmacy account may create orders for
PH_PATIENT_ID=
# PH-BIZ-003: order endpoint, relative to API_BASE_URL (TODO: confirm in DevTools)
PH_CREATE_ORDER_API=/pharmacy/orders
# PH-BIZ-006: in-app URL that opens patient B's order from patient A's context,
# plus B's order id (used to detect the order leaking through the API)
PH_CROSS_PATIENT_ORDER_PATH=
PH_FOREIGN_ORDER_ID=
# RFT-TMO-002: path fragment of the API call to fail (empty = every API GET)
PH_QUEUE_API=

# ---- Tuning ----
CURRENCY_SYMBOL=₹
# false = GEN-SEC-050 only reports missing headers (annotations) instead of failing
SEC_HEADERS_ENFORCE=true
WV_LCP_BUDGET_MS=2500
