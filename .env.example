# Copy to .env (gitignored) and fill in.

# ---- Targets (QA / local ONLY — global-setup refuses production-looking hosts) ----
# Local:  frontend `npm run dev` (5173) + swasthx_backend_website `npm run start:dev` (3000).
# The frontend must call the same API: set VITE_BASE_URL=http://localhost:3000 in the
# frontend's .env.development.local (see README "Running against local frontend + backend").
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
# QA instead:
# API_BASE_URL=https://websiteqa.api.swasthx.com

# Extra hosts that are QA even though their name doesn't contain qa/dev/staging/test/uat.
QA_ALLOWED_HOSTS=
# Browser requests to hosts matching this are aborted and fail the test.
BLOCK_HOSTS_REGEX=production

# ---- Auth ----
# api    = send OTP → verify OTP → /auth/login with the phones below (default)
# manual = never call the API; use only tokens captured with `npm run auth:manual -- <role>`
AUTH_MODE=api
# Header scheme used when specs call the API directly with a role token.
API_AUTH_SCHEME=Bearer
# Login page (used by the manual capture script).
UI_LOGIN_PATH=/login

# One test account per role. Phones must be on the backend's TEST_MOBILE_NUMBERS list
# (src/auth/constants.ts), which skips SMS and uses the fixed OTP.
# API login uses forceLogin, so it ends any browser session open on the same number.
# A role with no phone/OTP and no cached token is skipped, not failed.
TEST_SUPERADMIN_PHONE=5555555555
TEST_SUPERADMIN_OTP=765432

TEST_ADMIN_PHONE=2222222228
TEST_ADMIN_OTP=765432

TEST_RECEPTION_PHONE=5555555551
TEST_RECEPTION_OTP=765432

TEST_DOCTOR_PHONE=4444444440
TEST_DOCTOR_OTP=765432

TEST_DIAGNOSTIC_PHONE=8888888888
TEST_DIAGNOSTIC_OTP=765432

TEST_PHARMACY_PHONE=7777777777
TEST_PHARMACY_OTP=765432

# ---- Seed data for data-dependent specs (see README "Seed data") ----
# Hospital the test accounts belong to (the `hospitalId` claim in their JWT).
HOSPITAL_ID=
# AD-SEC-003 IDOR: a different hospital's id (tenant-isolation probe)
OTHER_HOSPITAL_ID=
# A billed pharmacy order in that hospital that came from the patient app:
#   PH_ORDER_CODE           its orderCode ("Order ID" in the details dialog)  (PH-FUN-001)
#   PH_ORDER_VISIT_ID       its visitId, shown on the queue card            (PH-FUN-001)
#   PH_PHR_ORDER_ID         its Mongo _id (PH-BIZ-006)
#   PH_PHR_ORDER_PATIENT_ID its patientId / ABHA address (PH-BIZ-006 positive control)
PH_ORDER_CODE=
PH_ORDER_VISIT_ID=
# Active Queue tab the order sits in (default: Order Delivered)
PH_ORDER_TAB=
PH_PHR_ORDER_ID=
PH_PHR_ORDER_PATIENT_ID=
# RFT-TMO-002: path fragment of the API call to fail (default /pharmacy/orders)
PH_QUEUE_API=
# DOC-WV-006/007: a patient id that opens /doctor/consult/:patientId for the doctor account
DOC_CONSULT_PATIENT_ID=

# ---- Tuning ----
CURRENCY_SYMBOL=₹
# false = GEN-SEC-050 only reports missing headers (annotations) instead of failing
SEC_HEADERS_ENFORCE=true
# Web Vitals: measurements per route (Measured = p75 of these) and engine (playwright | lighthouse)
WV_RUNS=3
WV_ENGINE=playwright
